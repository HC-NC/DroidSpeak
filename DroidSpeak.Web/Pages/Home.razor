@page "/"
@using System.Globalization
@using DroidSpeak
@using DroidSpeak.DSP
@using DroidSpeak.Modem
@using DroidSpeak.Music
@using DroidSpeak.NLP
@using DroidSpeak.Neural
@using DroidSpeak.Prosody
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>DroidSpeak — Interactive Web Playground</PageTitle>

<div class="ds-shell">
	<header class="ds-header">
		<div class="ds-title-row">
			<svg class="ds-logo" viewBox="0 0 64 64" aria-hidden="true">
				<rect width="64" height="64" rx="16" fill="#131a26" stroke="#243044" stroke-width="3" />
				<circle cx="32" cy="32" r="20" fill="#0b0f17" stroke="#38bdf8" stroke-width="3.5" />
				<circle cx="32" cy="32" r="10" fill="#38bdf8" fill-opacity="0.25" stroke="#38bdf8" stroke-width="2" />
				<circle cx="32" cy="32" r="4.5" fill="#e6edf3" />
				<circle cx="27" cy="27" r="2.2" fill="#38bdf8" />
			</svg>
			<h1>DroidSpeak</h1>
			<span class="ds-badge">WASM · ZERO DEPENDENCIES</span>
		</div>
		<p>Procedural astromech speech, MIDI/RTTTL music &amp; FSK steganography in C#.</p>
	</header>

	<section class="ds-card">
		<div class="ds-row-between">
			<label class="ds-label" style="margin:0">1. Droid Voice Profile</label>
			<button class="ds-chip" @onclick="() => ShowCustomizer = !ShowCustomizer">
				@(ShowCustomizer ? "▲ Hide Customizer" : "🎛️ Customize & Export JSON")
			</button>
		</div>

		<div class="ds-pills" style="margin-top:0.65rem">
			@foreach (var preset in VoicePresets)
			{
				<button class="ds-pill @(SelectedVoice == preset.Key ? "active" : "")"
						@onclick="() => SelectPreset(preset.Key)">
					<strong>@preset.Label</strong>
					<span>@preset.Desc</span>
				</button>
			}
		</div>

		@if (ShowCustomizer)
		{
			<div class="ds-customizer">
				<div class="ds-slider-group">
					<div class="ds-slider-group-title">Pitch &amp; Timbre</div>
					<div class="ds-sliders">
						<label>
							Min Freq: <strong>@_sliders.MinFreq Hz</strong>
							<input type="range" min="80" max="1000" step="10" @bind="_sliders.MinFreq" @bind:event="oninput" @onchange="MarkCustom" />
						</label>
						<label>
							Max Freq: <strong>@_sliders.MaxFreq Hz</strong>
							<input type="range" min="400" max="3200" step="20" @bind="_sliders.MaxFreq" @bind:event="oninput" @onchange="MarkCustom" />
						</label>
						<label>
							Speed: <strong>@((_sliders.SpeedPct / 100f).ToString("0.00", CultureInfo.InvariantCulture))x</strong>
							<input type="range" min="50" max="200" step="5" @bind="_sliders.SpeedPct" @bind:event="oninput" @onchange="MarkCustom" />
						</label>
						<label>
							FM Intensity: <strong>@((_sliders.FmPct / 100f).ToString("0.00", CultureInfo.InvariantCulture))</strong>
							<input type="range" min="10" max="250" step="5" @bind="_sliders.FmPct" @bind:event="oninput" @onchange="MarkCustom" />
						</label>
						<label>
							Chatter / Trills: <strong>@_sliders.ChatterPct%</strong>
							<input type="range" min="0" max="100" step="5" @bind="_sliders.ChatterPct" @bind:event="oninput" @onchange="MarkCustom" />
						</label>
						<label>
							Triangle Mix: <strong>@_sliders.TrianglePct%</strong>
							<input type="range" min="0" max="60" step="2" @bind="_sliders.TrianglePct" @bind:event="oninput" @onchange="MarkCustom" />
						</label>
					</div>
				</div>

				<div class="ds-slider-group">
					<div class="ds-slider-group-title">Envelope &amp; Resonant Filter</div>
					<div class="ds-sliders">
						<label>
							Attack: <strong>@_sliders.AttackMs ms</strong>
							<input type="range" min="2" max="100" step="1" @bind="_sliders.AttackMs" @bind:event="oninput" @onchange="MarkCustom" />
						</label>
						<label>
							Decay: <strong>@_sliders.DecayMs ms</strong>
							<input type="range" min="5" max="150" step="5" @bind="_sliders.DecayMs" @bind:event="oninput" @onchange="MarkCustom" />
						</label>
						<label>
							Sustain: <strong>@_sliders.SustainPct%</strong>
							<input type="range" min="10" max="100" step="5" @bind="_sliders.SustainPct" @bind:event="oninput" @onchange="MarkCustom" />
						</label>
						<label>
							Release: <strong>@_sliders.ReleaseMs ms</strong>
							<input type="range" min="5" max="200" step="5" @bind="_sliders.ReleaseMs" @bind:event="oninput" @onchange="MarkCustom" />
						</label>
						<label>
							Filter Cutoff: <strong>@((_sliders.FilterCutoffPct / 100f).ToString("0.00", CultureInfo.InvariantCulture))x</strong>
							<input type="range" min="80" max="400" step="5" @bind="_sliders.FilterCutoffPct" @bind:event="oninput" @onchange="MarkCustom" />
						</label>
						<label>
							Filter Resonance Q: <strong>@((_sliders.FilterResonancePct / 100f).ToString("0.00", CultureInfo.InvariantCulture))</strong>
							<input type="range" min="50" max="400" step="5" @bind="_sliders.FilterResonancePct" @bind:event="oninput" @onchange="MarkCustom" />
						</label>
						<label>
							Whistle Chance: <strong>@_sliders.WhistlePct%</strong>
							<input type="range" min="0" max="150" step="5" @bind="_sliders.WhistlePct" @bind:event="oninput" @onchange="MarkCustom" />
						</label>
					</div>
				</div>

				<div class="ds-slider-group">
					<div class="ds-slider-group-title">Rich DSP &amp; Vocal Formants</div>
					<div class="ds-sliders">
						<label>
							Formant Mix: <strong>@_sliders.FormantPct%</strong>
							<input type="range" min="0" max="100" step="1" @bind="_sliders.FormantPct" @bind:event="oninput" @onchange="MarkCustom" />
						</label>
						<label>
							Ring Modulation: <strong>@_sliders.RingModPct%</strong>
							<input type="range" min="0" max="100" step="1" @bind="_sliders.RingModPct" @bind:event="oninput" @onchange="MarkCustom" />
						</label>
						<label>
							Saturation Drive: <strong>@((_sliders.SaturationCenti / 100f).ToString("0.00", CultureInfo.InvariantCulture))</strong>
							<input type="range" min="0" max="400" step="5" @bind="_sliders.SaturationCenti" @bind:event="oninput" @onchange="MarkCustom" />
						</label>
						<label>
							Room / Early Reflections: <strong>@_sliders.RoomPct%</strong>
							<input type="range" min="0" max="100" step="1" @bind="_sliders.RoomPct" @bind:event="oninput" @onchange="MarkCustom" />
						</label>
						<label>
							Pitch Curvature: <strong>@_sliders.PitchCurvePct%</strong>
							<input type="range" min="0" max="100" step="1" @bind="_sliders.PitchCurvePct" @bind:event="oninput" @onchange="MarkCustom" />
						</label>
					</div>
				</div>

				<div class="ds-actions" style="margin-top:0.75rem">
					<button class="ds-chip" @onclick="ExportProfileJson">⬇ Download Profile (.json)</button>
					<label class="ds-chip">
						📂 Import Profile (.json)
						<InputFile OnChange="ImportProfileJson" accept=".json" style="display:none" />
					</label>
					<button class="ds-chip" @onclick="ResetToDefault">↺ Reset to Default</button>
				</div>
			</div>
		}
	</section>

	<section class="ds-card">
		<div class="ds-row-between">
			<label class="ds-label" for="ds-brain-select" style="margin:0">🧠 Prosody Engine / Brain</label>
			<span class="ds-badge">@ActiveBrainLabel</span>
		</div>

		<div class="ds-pills" style="margin-top:0.65rem; align-items:center">
			<select id="ds-brain-select" class="ds-input" style="max-width:22rem"
					disabled="@(_brains is null)"
					value="@SelectedBrain"
					@onchange="OnBrainSelectedAsync">
				<option value="@ClassicBrain">Rule-Based (Classic)</option>
				@foreach (var brain in _hostedBrains)
				{
					<option value="@HostedKey(brain)">@brain</option>
				}
				@if (_localBrainModel is not null)
				{
					<option value="@LocalBrain">Local upload: @_localBrainName</option>
				}
			</select>

			<label class="ds-chip">
				📂 Load .dsbrain File
				<InputFile OnChange="HandleBrainUpload" accept=".dsbrain" style="display:none" />
			</label>
		</div>

		@if (!string.IsNullOrEmpty(_brainStatus))
		{
			<div class="ds-status @(_brainStatusIsError ? "error" : "")">@_brainStatus</div>
		}
	</section>

	<nav class="ds-tabs">
		<button class="ds-tab @(ActiveTab == TabMode.Speech ? "active" : "")" @onclick="() => ActiveTab = TabMode.Speech">
			🗣️ Text-to-Beep
		</button>
		<button class="ds-tab @(ActiveTab == TabMode.Music ? "active" : "")" @onclick="() => ActiveTab = TabMode.Music">
			🎵 Music (MIDI / RTTTL)
		</button>
		<button class="ds-tab @(ActiveTab == TabMode.Modem ? "active" : "")" @onclick="() => ActiveTab = TabMode.Modem">
			📡 Acoustic Modem
		</button>
	</nav>

	<section class="ds-card">
		@if (ActiveTab == TabMode.Speech)
		{
			<label class="ds-label">2. Enter Text (English or Russian)</label>
			<textarea class="ds-input" rows="3" @bind="SpeechText" @bind:event="oninput"
					  placeholder="Type anything... Use !, ?, ... or ALL CAPS for emotion!"></textarea>

			<div class="ds-presets-row">
				<button class="ds-chip" @onclick='() => SpeechText = "Beep-beep! Hello there, systems are online!"'>Greeting</button>
				<button class="ds-chip" @onclick='() => SpeechText = "ALERT! Critical error in sector 7!"'>Alert!</button>
				<button class="ds-chip" @onclick='() => SpeechText = "Oh no... everything is broken again..."'>Sad...</button>
				<button class="ds-chip" @onclick='() => SpeechText = "Привет! Как дела? Всё работает отлично!"'>Русский</button>
			</div>

			<div class="ds-actions">
				<button class="ds-btn primary" disabled="@IsBusy" @onclick="SynthesizeSpeech">
					@(IsBusy ? "⏳ Synthesizing..." : "▶ Synthesize & Play")
				</button>
			</div>
		}
		else if (ActiveTab == TabMode.Music)
		{
			<label class="ds-label">2. RTTTL Ringtone String or Standard MIDI File (.mid)</label>
			<textarea class="ds-input" rows="2" @bind="RtttlInput" @bind:event="oninput"
					  placeholder="Paste RTTTL string..."></textarea>

			<div class="ds-presets-row">
				<button class="ds-chip" @onclick='() => RtttlInput = "Fanfare:d=16,o=5,b=150:c,e,g,8c6,16p,g,4c6"'>Fanfare</button>
				<button class="ds-chip" @onclick='() => RtttlInput = "OdeToJoy:d=4,o=5,b=125:e,e,f,g,g,f,e,d,c,c,d,e,e.,8d,2d"'>Ode to Joy</button>
				<label class="ds-chip">
					📂 Upload .MID File
					<InputFile OnChange="HandleMidiUpload" accept=".mid,.midi" style="display:none" />
				</label>
			</div>

			<label class="ds-checkbox">
				<input type="checkbox" @bind="SoloMelodyOnly" />
				<span><strong>Solo Lead Whistle Mode</strong> (mute harmony chords, keep expressive droid melody)</span>
			</label>

			<div class="ds-actions">
				<button class="ds-btn primary" disabled="@IsBusy" @onclick="PlayRtttl">
					@(IsBusy ? "⏳ Rendering..." : "▶ Render & Play RTTTL")
				</button>
			</div>
		}
		else if (ActiveTab == TabMode.Modem)
		{
			<label class="ds-label">2. Transmission Mode</label>
			<div class="ds-pills" style="margin-top:0.65rem">
				<button class="ds-pill @(SelectedModemMode == ModemMode.HighBandOverlay ? "active" : "")"
						@onclick="() => SelectedModemMode = ModemMode.HighBandOverlay">
					<strong>High-band overlay</strong>
					<span>14.6–17 kHz · full voice untouched</span>
				</button>
				<button class="ds-pill @(SelectedModemMode == ModemMode.AudibleChirpStream ? "active" : "")"
						@onclick="() => SelectedModemMode = ModemMode.AudibleChirpStream">
					<strong>Audible chirp stream</strong>
					<span>2.3–4.3 kHz · pause-safe chirps</span>
				</button>
			</div>

			<div class="ds-subtabs">
				<button class="ds-chip @(ModemSubMode == 0 ? "active" : "")" @onclick="() => { ModemSubMode = 0; DecodedResult = null; ModemDiagnostics = null; }">📤 Encode into Speech</button>
				<button class="ds-chip @(ModemSubMode == 1 ? "active" : "")" @onclick="() => { ModemSubMode = 1; DecodedResult = null; ModemDiagnostics = null; }">📥 Decode from .WAV / Mic</button>
			</div>

			@if (ModemSubMode == 0)
			{
				<label class="ds-label">3. Secret UTF-8 Message to Embed into Droid Speech (max 255 bytes)</label>
				<input class="ds-input" type="text" @bind="ModemText" @bind:event="oninput"
					   placeholder="Secret coordinates: 56.0153, 92.8932" />

				<div class="ds-actions">
					<button class="ds-btn primary" disabled="@IsBusy" @onclick="EncodeModem">
						@(IsBusy ? "⏳ Encoding..." : "📡 Encode & Play")
					</button>
					<button class="ds-btn" disabled="@IsBusy" @onclick="StartMicListen">
						@(_isListening ? "🎙️ Listening..." : "🎙️ Listen for Packets")
					</button>
					@if (_isListening)
					{
						<button class="ds-btn" @onclick="StopMicListen">⏹ Stop</button>
					}
				</div>
			}
			else
			{
				<label class="ds-label">3. Upload a 16-bit PCM .WAV File or Listen Live</label>
				<div class="ds-actions">
					<label class="ds-btn primary">
						📂 Choose .WAV File to Decode
						<InputFile OnChange="HandleWavDecodeUpload" accept=".wav" style="display:none" />
					</label>
					<button class="ds-btn" disabled="@IsBusy" @onclick="StartMicListen">
						@(_isListening ? "🎙️ Listening..." : "🎙️ Listen for Packets")
					</button>
					@if (_isListening)
					{
						<button class="ds-btn" @onclick="StopMicListen">⏹ Stop</button>
					}
				</div>
			}

			@if (!string.IsNullOrEmpty(_micStatus))
			{
				<div class="ds-modem-box">
					<span class="ds-modem-tag">MICROPHONE</span>
					<code>@_micStatus</code>
				</div>
			}

			@if (!string.IsNullOrEmpty(DecodedResult))
			{
				<div class="ds-modem-box">
					<span class="ds-modem-tag">FFT DECODER OUTPUT</span>
					<code>@DecodedResult</code>
				</div>
			}

			@if (!string.IsNullOrEmpty(ModemDiagnostics))
			{
				<div class="ds-modem-box">
					<span class="ds-modem-tag">FEC / CRC DIAGNOSTICS</span>
					<code>@ModemDiagnostics</code>
				</div>
			}
		}

		@if (IsBusy && RenderProgress > 0)
		{
			<div class="ds-progress-wrap">
				<div class="ds-progress-header">
					<span>@StatusMessage</span>
					<strong>@RenderProgress%</strong>
				</div>
				<div class="ds-progress-track">
					<div class="ds-progress-fill" style="width: @(RenderProgress)%"></div>
				</div>
			</div>
		}

		@if (!string.IsNullOrEmpty(AudioUrl))
		{
			<div class="ds-player-box">
				<div class="ds-vis-header">
					<span class="ds-vis-label">Visualizer</span>
					<div class="ds-vis-switch">
						<button type="button"
								class="ds-vis-btn @(VisualizerMode == "bars" ? "active" : "")"
								@onclick='() => SetVisualizerMode("bars")'>
							📊 Bars
						</button>
						<button type="button"
								class="ds-vis-btn @(VisualizerMode == "spectrogram" ? "active" : "")"
								@onclick='() => SetVisualizerMode("spectrogram")'>
							🌊 Spectrogram
						</button>
					</div>
				</div>
				<canvas id="ds-spectrum-canvas"
						class="ds-spectrum @(VisualizerMode == "spectrogram" ? "tall" : "")"
						width="1200"
						height="300">
				</canvas>
				<audio id="ds-audio-player" controls autoplay="@_autoplayPlayer" onplay="window.droidAudio.stopLiveStream()" src="@AudioUrl" class="ds-audio"></audio>
				<button class="ds-btn" @onclick="DownloadLastWav">⬇ Download .WAV</button>
			</div>
		}

		@if (!string.IsNullOrEmpty(StatusMessage))
		{
			<div class="ds-status @(IsError ? "error" : "")">@StatusMessage</div>
		}
	</section>

	<footer class="ds-footer">
		<div class="ds-shields">
			<a href="https://github.com/HC-NC/DroidSpeak" target="_blank">
				<img src="https://img.shields.io/badge/GitHub-DroidSpeak-181717?style=flat&logo=github&logoColor=white" alt="GitHub" />
			</a>
			<a href="https://nuget.org/packages/DroidSpeak.Core" target="_blank">
				<img src="https://img.shields.io/nuget/v/DroidSpeak.Core?style=flat&logo=nuget&label=NuGet" alt="Release" />
			</a>
			<a href="https://github.com/HC-NC/DroidSpeak/blob/main/LICENSE" target="_blank">
				<img src="https://img.shields.io/github/license/HC-NC/DroidSpeak?style=flat" alt="License" />
			</a>
			<a href="https://dotnet.microsoft.com/" target="_blank">
				<img src="https://img.shields.io/badge/-10.0-512BD4?style=flat&logo=dotnet&logoColor=white" alt=".NET 10" />
			</a>
		</div>
		<div>Built with .NET 10 Blazor WebAssembly</div>
	</footer>
</div>

@code {
	private enum TabMode { Speech, Music, Modem }

	private TabMode ActiveTab { get; set; } = TabMode.Speech;
	private int ModemSubMode { get; set; } = 0; // 0 = Encode, 1 = Decode
	private string SelectedVoice { get; set; } = "r2";
	private bool ShowCustomizer { get; set; }
	private bool IsBusy { get; set; }
	private int RenderProgress { get; set; }

	// Customizer state. Every value is an integer (Hz, milliseconds or percent) so it binds
	// directly to an HTML range input without decimal-separator issues, and the profile round trip
	// lives in DroidSpeak.Core where the presets can be verified by tests.
	private VoiceProfileSliders _sliders = VoiceProfileSliders.FromProfile(new DroidVoiceProfile());
	private string _lastPresetKey = "r2";
	private bool _autoplayPlayer = true;

	private string SpeechText { get; set; } = "Beep-beep! Hello there, systems are online!";
	private string RtttlInput { get; set; } = "OdeToJoy:d=4,o=5,b=125:e,e,f,g,g,f,e,d,c,c,d,e,e.,8d,2d";
	private string ModemText { get; set; } = "Secret coordinates: 56.0153, 92.8932";
	private ModemMode SelectedModemMode { get; set; } = ModemMode.HighBandOverlay;
	private string? ModemDiagnostics { get; set; }
	private StreamingAcousticDemodulator? _micDemodulator;
	private DotNetObjectReference<Home>? _micReference;
	private bool _isListening;
	private string? _micStatus;

	private bool SoloMelodyOnly { get; set; } = true;
	private float[]? LastSamples { get; set; }
	private int LastSampleRate { get; set; } = DroidSynthesizer.DefaultSampleRate;
	private string LastFileName { get; set; } = "droid_output.wav";
	private string? AudioUrl { get; set; }
	private string? _spectrumAttachedUrl;
	private string VisualizerMode { get; set; } = "bars";
	private string? StatusMessage { get; set; }
	private string? DecodedResult { get; set; }
	private bool IsError { get; set; }

	// Prosody engine selection. "classic" is always available; hosted brains arrive from
	// wwwroot/brains/manifest.json at startup and one local upload can join them per session.
	// Any load failure falls back to RuleBasedProsodyPredictor.Shared instead of breaking audio.
	private const string ClassicBrain = "classic";
	private const string LocalBrain = "local";
	private const string HostedPrefix = "host:";

	private string SelectedBrain { get; set; } = ClassicBrain;
	private BrainCatalog? _brains;
	private IReadOnlyList<string> _hostedBrains = [];
	private MlpModel? _localBrainModel;
	private string? _localBrainName;
	private IProsodyPredictor _activePredictor = RuleBasedProsodyPredictor.Shared;
	private int _brainSequence;
	private string? _brainStatus;
	private bool _brainStatusIsError;

	private string ActiveBrainLabel => SelectedBrain switch
	{
		ClassicBrain => "Rule-Based",
		LocalBrain => "Local .dsbrain",
		_ => HostedName(SelectedBrain),
	};

	private static readonly (string Key, string Label, string Desc)[] VoicePresets =
	[
		("r2", "R2 Classic", "350–1600 Hz · Expressive"),
		("grumpy", "Grumpy", "220–1100 Hz · Heavy FM"),
		("bass", "Bass Unit", "120–650 Hz · Deep Droid"),
		("tiny", "Tiny Unit", "600–2400 Hz · Fast Chirps"),
	];

	protected override async Task OnInitializedAsync()
	{
		ApplyProfileToSliders(DroidVoiceProfile.R2);

		// Populate the brain dropdown before the first render settles; an unreachable or empty
		// manifest simply leaves "Rule-Based (Classic)" as the only choice.
		_brains = new BrainCatalog(Http);
		var manifest = await _brains.ListBrainsAsync();
		_hostedBrains = manifest.Files;
		if (manifest.Warning is not null)
		{
			SetBrainStatus(manifest.Warning, isError: false);
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!string.IsNullOrEmpty(AudioUrl) && AudioUrl != _spectrumAttachedUrl)
		{
			_spectrumAttachedUrl = AudioUrl;
			await JS.InvokeVoidAsync(
				"droidAudio.attachVisualizer",
				"ds-audio-player",
				"ds-spectrum-canvas");
		}
		else if (!string.IsNullOrEmpty(AudioUrl) && VisualizerMode == "spectrogram")
		{
			await JS.InvokeVoidAsync("droidAudio.restoreSpectrogramSnapshotById", "ds-spectrum-canvas");
		}
	}

	private async Task SetVisualizerMode(string mode)
	{
		VisualizerMode = mode;
		await JS.InvokeVoidAsync("droidAudio.setVisualizerMode", mode, "ds-spectrum-canvas");
	}

	private DroidVoiceProfile BuildActiveProfile() => _sliders.ToProfile();

	private void ApplyProfileToSliders(DroidVoiceProfile p) =>
		_sliders = VoiceProfileSliders.FromProfile(p);

	private void SelectPreset(string key)
	{
		_lastPresetKey = key;
		SelectedVoice = key;
		ApplyProfileToSliders(GetPreset(key));
	}

	private void ResetToDefault()
	{
		// Return to the last preset the user picked, or to the classic R2 voice.
		SelectPreset(_lastPresetKey);
	}

	private static DroidVoiceProfile GetPreset(string key) => key switch
	{
		"grumpy" => DroidVoiceProfile.Grumpy,
		"bass" => DroidVoiceProfile.Bass,
		"tiny" => DroidVoiceProfile.Tiny,
		_ => DroidVoiceProfile.R2
	};

	private void MarkCustom() => SelectedVoice = "custom";

	private async Task ExportProfileJson()
	{
		var json = BuildActiveProfile().ToJson();
		var fileName = $"droid_profile_{SelectedVoice}.json";
		await JS.InvokeVoidAsync("droidAudio.downloadText", json, fileName);
		SetStatus($"Exported {fileName}");
	}

	private async Task ImportProfileJson(InputFileChangeEventArgs e)
	{
		try
		{
			using var stream = e.File.OpenReadStream(maxAllowedSize: 64 * 1024);
			using var reader = new StreamReader(stream);
			var json = await reader.ReadToEndAsync();

			var p = DroidVoiceProfile.FromJson(json).Normalized();
			SelectedVoice = "custom";
			ApplyProfileToSliders(p);

			SetStatus($"Loaded profile from {e.File.Name}");
		}
		catch (Exception ex)
		{
			SetError($"Invalid JSON profile: {ex.Message}");
		}
	}

	private static string HostedKey(string fileName) => HostedPrefix + fileName;
	private static string HostedName(string key) => key[HostedPrefix.Length..];

	private async Task OnBrainSelectedAsync(ChangeEventArgs e)
	{
		var value = e.Value?.ToString() ?? ClassicBrain;
		await SelectBrainAsync(value);
	}

	/// <summary>
	/// Switches the active prosody engine. Hosted models are fetched on demand and local uploads are
	/// reused in memory, so re-picking an engine never re-downloads. A monotonic sequence discards a
	/// slow fetch that a newer selection has already superseded.
	/// </summary>
	private async Task SelectBrainAsync(string key)
	{
		if (key == ClassicBrain)
		{
			// Invalidate any in-flight download so it cannot override this choice later.
			++_brainSequence;
			SelectedBrain = key;
			_activePredictor = RuleBasedProsodyPredictor.Shared;
			SetBrainStatus("Rule-Based prosody: the classic procedural voice.", isError: false);
			return;
		}

		var attempt = ++_brainSequence;
		try
		{
			MlpModel model;
			if (key == LocalBrain)
			{
				model = _localBrainModel
					?? throw new InvalidOperationException("No local brain is loaded.");
			}
			else if (key.StartsWith(HostedPrefix, StringComparison.Ordinal))
			{
				var fileName = HostedName(key);
				SetBrainStatus($"Downloading {fileName}...", isError: false);
				model = await _brains!.LoadBrainAsync(fileName);
			}
			else
			{
				throw new InvalidOperationException("Unknown prosody engine selection.");
			}

			// A newer selection landed while this one was downloading: keep its result, drop ours.
			if (attempt != _brainSequence)
			{
				return;
			}

			_activePredictor = new NeuralProsodyPredictor(model);
			SelectedBrain = key;
			SetBrainStatus(
				key == LocalBrain
					? $"Neural prosody active: local brain '{_localBrainName}' ({model.LayerCount} layers)."
					: $"Neural prosody active: {HostedName(key)} ({model.LayerCount} layers).",
				isError: false);
		}
		catch (OperationCanceledException)
		{
			if (attempt == _brainSequence)
			{
				SetBrainStatus("Prosody engine switch cancelled.", isError: false);
			}
		}
		catch (Exception ex)
		{
			if (attempt != _brainSequence)
			{
				return;
			}

			// Graceful fallback: the classic voice always survives a broken or missing brain.
			if (key == LocalBrain)
			{
				_localBrainModel = null;
				_localBrainName = null;
			}

			SelectedBrain = ClassicBrain;
			_activePredictor = RuleBasedProsodyPredictor.Shared;
			SetBrainStatus(
				key == LocalBrain
					? $"Invalid brain file: {ex.Message}. Keeping Rule-Based."
					: $"Could not load the neural prosody model ({ex.Message}). Keeping Rule-Based.",
				isError: true);
		}
	}

	/// <summary>
	/// Reads a user-selected <c>.dsbrain</c> entirely client-side and registers it as the local
	/// upload option without sending any bytes to the server.
	/// </summary>
	private async Task HandleBrainUpload(InputFileChangeEventArgs e)
	{
		var fileName = e.File.Name;
		try
		{
			IsBusy = true;
			var bytes = await ReadBrowserFileWithProgressAsync(
				e.File, BrainCatalog.MaxBrainBytes, startPct: 0, endPct: 60);
			var model = BrainCatalog.LoadBrainBytes(bytes);

			_localBrainModel = model;
			_localBrainName = fileName;
			await SelectBrainAsync(LocalBrain);
		}
		catch (Exception ex) when (ex is not OperationCanceledException)
		{
			SetBrainStatus($"Invalid brain file: {ex.Message}. Keeping the current engine.", isError: true);
		}
		finally
		{
			IsBusy = false;
			RenderProgress = 0;
		}
	}

	private void SetBrainStatus(string message, bool isError)
	{
		_brainStatus = message;
		_brainStatusIsError = isError;
	}



	private async Task SynthesizeSpeech()
	{
		if (string.IsNullOrWhiteSpace(SpeechText))
		{
			SetError("Please enter some text first.");
			return;
		}

		IsBusy = true;
		SetStatus("Synthesizing speech...");
		await Task.Yield();

		try
		{
			var synth = new DroidSynthesizer(
				profile: BuildActiveProfile(),
				predictor: _activePredictor);
			var stream = synth.CreateStream(SpeechText);

			var phrases = TextParser.Parse(SpeechText);
			var info = phrases.Count > 0
				? $"Valence={phrases.Average(p => p.Emotion.Valence):0.00}, Arousal={phrases.Average(p => p.Emotion.Arousal):0.00}"
				: "Rendered";

			await StreamIntoPlayerAsync(
				stream.SampleRate,
				stream.TotalSamples,
				buffer => stream.Read(buffer),
				() => stream.Position,
				"droid_speech.wav",
				info,
				"Streaming speech...");
		}
		catch (Exception ex)
		{
			SetError(ex.Message);
		}
		finally
		{
			IsBusy = false;
		}
	}

	private async Task PlayRtttl()
	{
		if (string.IsNullOrWhiteSpace(RtttlInput))
		{
			SetError("Please enter an RTTTL string or upload a .mid file.");
			return;
		}

		IsBusy = true;
		SetStatus("Rendering RTTTL...");
		await Task.Yield();

		try
		{
			var score = RtttlParser.Shared.Parse(RtttlInput);
			await RenderScoreToPlayer(score, "droid_rtttl.wav");
		}
		catch (Exception ex)
		{
			SetError($"RTTTL error: {ex.Message}");
		}
		finally
		{
			IsBusy = false;
		}
	}

	private async Task StepProgressAsync(int percent, string message)
	{
		RenderProgress = percent;
		StatusMessage = message;
		IsError = false;
		StateHasChanged();
		await Task.Delay(16); // Yield 1 animation frame (16ms) so the browser repaints the progress bar
	}

	/// <summary>
	/// Streams a rendered utterance straight to the browser: each chunk is queued on a Web Audio
	/// graph as soon as it is synthesized, so playback starts before the whole buffer exists.
	/// When rendering finishes, the full WAV is attached to the &lt;audio&gt; element (without
	/// autoplay) so it can be replayed, seeked or downloaded.
	/// </summary>
	private async Task StreamIntoPlayerAsync(
		int sampleRate,
		int totalSamples,
		Func<float[], int> read,
		Func<int> position,
		string wavName,
		string details,
		string progressLabel)
	{
		// The spectrum canvas only exists once the player box is rendered, so make it visible
		// first and give Blazor a frame to mount it before starting the live stream.
		if (string.IsNullOrEmpty(AudioUrl))
		{
			AudioUrl = "about:blank";
			_spectrumAttachedUrl = AudioUrl;
			StateHasChanged();
			await Task.Delay(50);
		}

		var finalBuffer = new float[totalSamples];
		var chunkSize = Math.Max(1, sampleRate / 2);
		var buffer = new float[chunkSize];
		var offset = 0;

		await StepProgressAsync(1, progressLabel);
		await JS.InvokeVoidAsync("droidAudio.startLiveStream", "ds-spectrum-canvas");

		while (offset < totalSamples)
		{
			var written = read(buffer);
			if (written <= 0)
			{
				break;
			}

			var chunk = buffer.AsSpan(0, written);
			chunk.CopyTo(finalBuffer.AsSpan(offset));
			offset += written;

			// Play this chunk immediately while the remaining audio is still being rendered.
			await JS.InvokeVoidAsync("droidAudio.enqueueStreamChunk", chunk.ToArray(), sampleRate);

			var percent = (int)(100.0 * position() / totalSamples);
			await StepProgressAsync(percent, $"{progressLabel} {percent}%");
		}

		// The live graph already played this audio; attach the finished WAV without autoplay.
		_autoplayPlayer = false;
		await LoadIntoPlayer(finalBuffer, sampleRate, wavName, details);
	}

	private async Task<byte[]> ReadBrowserFileWithProgressAsync(IBrowserFile file, long maxAllowedSize, int startPct, int endPct)
	{
		using var stream = file.OpenReadStream(maxAllowedSize);
		using var ms = new MemoryStream((int)Math.Min(file.Size, maxAllowedSize));
		var buffer = new byte[65536];
		long totalRead = 0;
		int read;

		while ((read = await stream.ReadAsync(buffer, 0, buffer.Length)) > 0)
		{
			ms.Write(buffer, 0, read);
			totalRead += read;
			if (file.Size > 0)
			{
				int pct = startPct + (int)((endPct - startPct) * (totalRead / (double)file.Size));
				await StepProgressAsync(pct, $"Reading {file.Name} ({totalRead / 1024} KB)...");
			}
		}

		return ms.ToArray();
	}

	private async Task RenderScoreWithProgressAsync(DroidScore score, string wavName, string? fallbackTitle = null)
	{
		var profile = BuildActiveProfile();
		var musicSynth = new DroidMusicSynthesizer(profile: profile);
		var stream = musicSynth.CreateStream(score, profile, SoloMelodyOnly);

		int totalNotes = score.Notes.Count;
		var title = string.IsNullOrWhiteSpace(score.Title) ? (fallbackTitle ?? "Melody") : score.Title;
		var extra = $"'{title}' · {totalNotes} notes{(SoloMelodyOnly ? " · solo" : "")}";

		await StreamIntoPlayerAsync(
			stream.SampleRate,
			stream.TotalSamples,
			buffer => stream.Read(buffer),
			() => stream.Position,
			wavName,
			extra,
			$"Streaming {totalNotes} notes...");
	}

	private async Task HandleWavDecodeUpload(InputFileChangeEventArgs e)
	{
		IsBusy = true;
		DecodedResult = null;
		await StepProgressAsync(5, $"Reading {e.File.Name}...");

		try
		{
			var bytes = await ReadBrowserFileWithProgressAsync(e.File, 10 * 1024 * 1024, startPct: 5, endPct: 50);

			await StepProgressAsync(65, "Parsing 16-bit PCM WAV header...");
			var (samples, sampleRate) = WavReader.ReadMonoPcm16(bytes);

			await StepProgressAsync(85, "Running FFT demodulator, Hamming FEC & CRC-16...");
			if (DroidModemDecoder.TryDecode(samples, sampleRate, out var result))
			{
				DecodedResult = result.Text;
				ModemDiagnostics = DescribeModemResult(result);
				SetStatus($"Successfully decoded {result.Text.Length} characters from {e.File.Name}.");
			}
			else
			{
				DecodedResult = "<no valid droid packet found in this WAV>";
				ModemDiagnostics = null;
				SetStatus($"Finished scanning {e.File.Name}, no modem payload detected.");
			}

			await StepProgressAsync(100, "Done!");
		}
		catch (Exception ex)
		{
			SetError($"WAV decode error: {ex.Message}");
		}
		finally
		{
			IsBusy = false;
			RenderProgress = 0;
		}
	}

	private async Task HandleMidiUpload(InputFileChangeEventArgs e)
	{
		IsBusy = true;
		RenderProgress = 2;
		SetStatus($"Reading {e.File.Name}...");
		await Task.Delay(1);

		try
		{
			var bytes = await ReadBrowserFileWithProgressAsync(e.File, 2 * 1024 * 1024, startPct: 2, endPct: 25);

			RenderProgress = 30;
			SetStatus("Parsing MIDI structure...");
			await Task.Delay(1);

			var score = MidiParser.Shared.Parse(bytes);
			await RenderScoreWithProgressAsync(score, Path.ChangeExtension(e.File.Name, ".wav"), e.File.Name);
		}
		catch (Exception ex)
		{
			SetError($"MIDI error: {ex.Message}");
		}
		finally
		{
			IsBusy = false;
			RenderProgress = 0;
		}
	}

	private async Task RenderScoreToPlayer(DroidScore score, string wavName, string? fallbackTitle = null)
	{
		await RenderScoreWithProgressAsync(score, wavName, fallbackTitle);
	}

	private async Task EncodeModem()
	{
		if (string.IsNullOrWhiteSpace(ModemText))
		{
			SetError("Please enter a payload message.");
			return;
		}

		IsBusy = true;
		SetStatus($"Encoding {SelectedModemMode} packet into speech...");
		await Task.Yield();

		try
		{
			var synth = new DroidSynthesizer(
				profile: BuildActiveProfile(),
				predictor: _activePredictor);
			var speech = synth.Synthesize(ModemText);
			var mixed = DroidModemEncoder.EncodeIntoSpeech(
				ModemText,
				speech,
				SelectedModemMode,
				synth.SampleRate);

			if (DroidModemDecoder.TryDecode(mixed, synth.SampleRate, out var result))
			{
				DecodedResult = result.Text;
				ModemDiagnostics = DescribeModemResult(result);
			}
			else
			{
				DecodedResult = "<self-check decode failed>";
				ModemDiagnostics = null;
			}

			_autoplayPlayer = true;
			await LoadIntoPlayer(mixed, synth.SampleRate, "droid_transmit.wav", $"{SelectedModemMode} Ready");
		}
		catch (Exception ex)
		{
			SetError(ex.Message);
		}
		finally
		{
			IsBusy = false;
		}
	}

	private static string DescribeModemResult(ModemDecodeResult result) =>
		$"{result.Mode} · CRC {(result.CrcValid ? "OK" : "FAIL")} · " +
		$"FEC corrected {result.CorrectedBits} bit(s) · " +
		$"clock {result.ClockDriftPpm.ToString("+0;-0;0", CultureInfo.InvariantCulture)} ppm" +
		(result.Legacy ? " · legacy v0.8" : string.Empty);

	private async Task StartMicListen()
	{
		if (_isListening)
		{
			return;
		}

		try
		{
			_micReference?.Dispose();
			_micReference = DotNetObjectReference.Create(this);
			var sampleRate = await JS.InvokeAsync<int>("droidAudio.startMicCapture", _micReference);

			if (SelectedModemMode == ModemMode.HighBandOverlay && sampleRate < 38000)
			{
				throw new InvalidOperationException(
					$"High-band overlay needs at least 38 kHz; this microphone runs at {sampleRate} Hz. " +
					"Choose Audible chirp stream instead.");
			}

			_micDemodulator = new StreamingAcousticDemodulator(sampleRate);
			_isListening = true;
			_micStatus = $"Listening at {sampleRate} Hz with {SelectedModemMode}...";
			SetStatus(_micStatus);
		}
		catch (Exception ex)
		{
			_micDemodulator = null;
			_micReference?.Dispose();
			_micReference = null;
			_isListening = false;
			_micStatus = null;
			SetError($"Microphone unavailable: {ex.Message}");
		}
	}

	private async Task StopMicListen()
	{
		try
		{
			await JS.InvokeVoidAsync("droidAudio.stopMicCapture");
		}
		catch (JSException)
		{
			// The browser may have already torn down the capture context.
		}

		_micDemodulator = null;
		_micReference?.Dispose();
		_micReference = null;
		_isListening = false;
		_micStatus = "Microphone stopped.";
		SetStatus(_micStatus);
	}

	[JSInvokable]
	public Task OnMicSamples(float[] samples, int sampleRate)
	{
		if (!_isListening || _micDemodulator is null || sampleRate != _micDemodulator.SampleRate)
		{
			return Task.CompletedTask;
		}

		_micDemodulator.Feed(samples);
		while (_micDemodulator.TryReadPacket(out var result))
		{
			var text = result.Text;
			var diagnostics = DescribeModemResult(result);
			_ = InvokeAsync(() =>
			{
				DecodedResult = text;
				ModemDiagnostics = diagnostics;
				_micStatus = $"Packet received at {sampleRate} Hz.";
				SetStatus(_micStatus);
				StateHasChanged();
			});
		}

		return Task.CompletedTask;
	}

	private async Task LoadIntoPlayer(float[] samples, int sampleRate, string fileName, string details)
	{
		// When the <audio> element autoplays, it becomes the playback source: silence any live
		// Web Audio chunks first so the two never play on top of each other.
		if (_autoplayPlayer)
		{
			await JS.InvokeVoidAsync("droidAudio.stopLiveStream");
		}

		LastSamples = samples;
		LastSampleRate = sampleRate;
		LastFileName = fileName;

		AudioUrl = await JS.InvokeAsync<string>("droidAudio.createWavUrl", samples, sampleRate);
		var sec = (samples.Length / (double)sampleRate).ToString("0.00", CultureInfo.InvariantCulture);
		SetStatus($"{details} · {sec} s ({samples.Length} samples)");
	}

	private async Task DownloadLastWav()
	{
		if (LastSamples is not null)
		{
			await JS.InvokeVoidAsync("droidAudio.downloadWav", LastSamples, LastSampleRate, LastFileName);
		}
	}

	private void SetStatus(string msg) { StatusMessage = msg; IsError = false; }
	private void SetError(string msg) { StatusMessage = msg; IsError = true; }
}