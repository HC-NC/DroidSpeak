<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsAotCompatible>true</IsAotCompatible>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<RootNamespace>DroidSpeak</RootNamespace>
		<AssemblyName>DroidSpeak.Core</AssemblyName>

		<PackageId>DroidSpeak.Core</PackageId>
		<Description>Zero-dependency, NativeAOT-compatible C# library for procedural synthesis of expressive astromech-style droid speech, polyphonic MIDI/RTTTL music, real-time audio streaming, and FSK acoustic steganography.</Description>
		<PackageTags>audio;dsp;synth;tts;droid;r2d2;midi;rtttl;streaming;fsk;modem;procedural;gamedev</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\README.md')" />
	</ItemGroup>

</Project>
