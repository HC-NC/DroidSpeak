<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>DroidSpeak.Trainer</RootNamespace>
		<AssemblyName>DroidSpeak.Trainer</AssemblyName>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!--
	  Deliberately empty of PackageReference: the trainer is pure C# math so a distillation run
	  works on any machine that has the SDK, with nothing to restore beyond DroidSpeak.Core itself.
	-->
	<ItemGroup>
		<ProjectReference Include="..\DroidSpeak.Core\DroidSpeak.Core.csproj" />
	</ItemGroup>

</Project>
